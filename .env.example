# AWS Cognito Configuration
# Get these values from your AWS Cognito Console

# AWS Cognito Identity Pool ID (format: us-east-2:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
NEXT_PUBLIC_AWS_COGNITO_IDENTITY_POOL_ID=

# AWS Cognito User Pool ID (format: us-east-2_XXXXXXXXX)
NEXT_PUBLIC_AWS_USER_POOLS_ID=

# AWS Cognito User Pool Web Client ID
NEXT_PUBLIC_AWS_USER_POOLS_WEB_CLIENT_ID=

# AWS Cognito OAuth Domain (format: your-domain.auth.us-east-2.amazoncognito.com)
NEXT_PUBLIC_COGNITO_OAUTH_DOMAIN=

# OAuth Redirect URLs
NEXT_PUBLIC_REDIRECT_SIGN_IN=http://localhost:3000/
NEXT_PUBLIC_REDIRECT_SIGN_OUT=http://localhost:3000/

***REMOVED***
# Get this from Google Cloud Console (format: XXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com)
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# AWS S3 Storage Configuration
# S3 bucket name for user-uploaded media files
NEXT_PUBLIC_AWS_USER_FILES_S3_BUCKET=
